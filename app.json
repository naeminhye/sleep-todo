{
  "expo": {
    "name": "Sleepy To-do",
    "slug": "sleepy-todo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f0e1a"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.yourname.sleepytodo"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f0e1a"
      },
      "package": "com.yourname.sleepytodo"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/CherryBombOne-Regular.ttf",
            "./assets/fonts/Cause-Regular.ttf",
            "./assets/fonts/Cause-Medium.ttf"
          ]
        }
      ]
    ],
    "scheme": "sleepy-todo",
    "experiments": {
      "typedRoutes": true
    }
  }
}
